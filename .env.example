# =====================================================
#  雞蛋產銷履歷 - 環境變數設定
# =====================================================

# Xaman (Xumm) API 憑證 - 從 Xaman Developer Console 取得
# 1. 前往 https://apps.xaman.dev/ 並登入 (需有 Xaman App)
# 2. 建立新應用程式 -> 取得 API Key 與 API Secret
# ⚠️ 測試時請確保手機 Xaman App 設定為 Testnet 模式
XUMM_API_KEY=70e869c5-2384-4151-b453-12365455dac0
XUMM_API_SECRET=109332dd-476b-4f0c-b998-3a88d4ba32f0

# 物流接收帳戶種子
# ⚠️ 小組專案：所有人請填入同一組種子，這樣查到的資料才會一致
# 讓一個人先留空啟動 server，它會自動生成並印出種子，
# 再把那串種子複製貼到所有人的 .env 這裡
# 填了之後請確保該帳戶在 Testnet 上有足夠 XRP
LOGISTICS_SEED=sEdTEvYbTkRaMY3HmVo8GXEpvASDEaP

# ─── 多重簽章角色設定 ──────────────────────────────────────
# 支援多個錢包地址，逗號分隔  e.g. rABC...,rXYZ...
# 填寫後該步驟只能由列出的錢包簽署。
# 從 Xaman App 的帳戶詳情可以查到你的錢包地址 (r開頭)。
# 如果留空則不限制（任何人都可以簽）。
MANUFACTURER_ADDRESS=rawcEz5a3AmW8XXkgmK1zVJUB5zuMtePJb
LOGISTICS_ADDRESS=rGxhcgCh8rtgwj2cgPXTqe6hiJLss5nvnk
RETAILER_ADDRESS=r4CHhwhx78Re4Eax3Axzs2Uzf4dBUSZaX2

# 伺服器埠號 (預設 3000)
PORT=3000
